APP_NAME=Aegis
DATABASE_URL=sqlite:///./aegis.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
API_PREFIX=/api/v1

# --- Authentication ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit a real secret to version control.
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_before_use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
